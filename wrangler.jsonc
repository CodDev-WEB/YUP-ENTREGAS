{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yup-entregas",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "main": "_worker.js"
}
